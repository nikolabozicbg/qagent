# ===========================================
# AI Provider Configuration
# ===========================================
# Choose your AI provider: 'openai' or 'anthropic'
# Claude (anthropic) is recommended for better code generation
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o

# Anthropic (Claude) Configuration - RECOMMENDED for code generation
# Get API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===========================================
# Server Configuration
# ===========================================
PORT=3001
NODE_ENV=development

# Admin API Key (for bypassing rate limits during development/testing)
# Generate a strong random key: openssl rand -hex 32
ADMIN_API_KEY=your-secret-admin-key-here

# ===========================================
# Database Configuration
# ===========================================
# Local development (Docker)
DATABASE_URL=postgresql://qagent:qagent_dev@localhost:5432/qagent

# Production (Supabase) - set in environment
# DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
