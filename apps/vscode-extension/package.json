{
  "name": "qagenai",
  "displayName": "QAgenAI - AI Test Generation",
  "description": "AI-powered test generation and self-healing for your code",
  "version": "0.0.1",
  "publisher": "qagenai",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onCommand:qagenai.generateTests",
    "onView:qagenai.chatView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "qagenai.generateTests",
        "title": "Generate Tests",
        "category": "QAgenAI"
      },
      {
        "command": "qagenai.openChat",
        "title": "Open Test Assistant",
        "category": "QAgenAI"
      },
      {
        "command": "qagenai.analyzeWorkspace",
        "title": "Analyze Coverage",
        "category": "QAgenAI",
        "icon": "$(sync)"
      },
      {
        "command": "qagenai.generateTestsForFile",
        "title": "Generate Test",
        "icon": "$(sparkle)"
      },
      {
        "command": "qagenai.installFramework",
        "title": "Install Framework",
        "icon": "$(package)"
      },
      {
        "command": "qagenai.showSetupWizard",
        "title": "Setup Testing",
        "category": "QAgenAI",
        "icon": "$(tools)"
      },
      {
        "command": "qagenai.generateAllTests",
        "title": "Generate All Tests",
        "icon": "$(rocket)"
      },
      {
        "command": "qagenai.improveTest",
        "title": "Improve Test Coverage",
        "icon": "$(arrow-up)"
      },
      {
        "command": "qagenai.runTests",
        "title": "Run Tests",
        "icon": "$(run-all)"
      },
      {
        "command": "qagenai.installTestFramework",
        "title": "Install Framework",
        "icon": "$(cloud-download)"
      },
      {
        "command": "qagenai.runTest",
        "title": "Run Test",
        "category": "QAgenAI",
        "icon": "$(run)"
      },
      {
        "command": "qagenai.watchTest",
        "title": "Watch Test",
        "category": "QAgenAI",
        "icon": "$(eye)"
      },
      {
        "command": "qagenai.debugTest",
        "title": "Debug Test",
        "category": "QAgenAI",
        "icon": "$(debug)"
      },
      {
        "command": "qagenai.analyzeTestQuality",
        "title": "Analyze Test Quality",
        "category": "QAgenAI",
        "icon": "$(pulse)"
      },
      {
        "command": "qagenai.showQualityReport",
        "title": "Show Quality Report",
        "category": "QAgenAI",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "qagenai.generateTests",
          "group": "navigation",
          "when": "resourceExtname =~ /\\.(ts|js|py|tsx|jsx)$/"
        },
        {
          "command": "qagenai.runTest",
          "group": "qagenai@1",
          "when": "resourceExtname =~ /\\.(spec|test)\\.(ts|js|py|tsx|jsx|go|java)$/ || resourceFilename =~ /.*_test\\.(go|py)$/ || resourceFilename =~ /.*Test\\.java$/"
        },
        {
          "command": "qagenai.watchTest",
          "group": "qagenai@2",
          "when": "resourceExtname =~ /\\.(spec|test)\\.(ts|js|tsx|jsx)$/"
        },
        {
          "command": "qagenai.debugTest",
          "group": "qagenai@3",
          "when": "resourceExtname =~ /\\.(spec|test)\\.(ts|js|tsx|jsx)$/"
        }
      ],
      "editor/context": [
        {
          "command": "qagenai.generateTests",
          "group": "navigation"
        },
        {
          "command": "qagenai.runTest",
          "group": "qagenai@1",
          "when": "resourceExtname =~ /\\.(spec|test)\\.(ts|js|py|tsx|jsx|go|java)$/ || resourceFilename =~ /.*_test\\.(go|py)$/ || resourceFilename =~ /.*Test\\.java$/"
        },
        {
          "command": "qagenai.watchTest",
          "group": "qagenai@2",
          "when": "resourceExtname =~ /\\.(spec|test)\\.(ts|js|tsx|jsx)$/"
        },
        {
          "command": "qagenai.debugTest",
          "group": "qagenai@3",
          "when": "resourceExtname =~ /\\.(spec|test)\\.(ts|js|tsx|jsx)$/"
        }
      ],
      "view/item/context": [
        {
          "command": "qagenai.generateTestsForFile",
          "when": "view == qagenai.coverageView && viewItem == fileWithoutTest",
          "group": "inline"
        },
        {
          "command": "qagenai.generateTestsForFile",
          "when": "view == qagenai.coverageView && viewItem == fileWithoutTest"
        },
        {
          "command": "qagenai.generateTestsForFile",
          "when": "view == qagenai.coverageView && viewItem == testTypeRecommendation",
          "group": "inline"
        },
        {
          "command": "qagenai.generateTestsForFile",
          "when": "view == qagenai.coverageView && viewItem == testTypeRecommendation"
        },
        {
          "command": "qagenai.improveTest",
          "when": "view == qagenai.coverageView && viewItem == fileWithTest",
          "group": "inline"
        },
        {
          "command": "qagenai.improveTest",
          "when": "view == qagenai.coverageView && viewItem == fileWithTest"
        },
        {
          "command": "qagenai.installFramework",
          "when": "view == qagenai.coverageView && viewItem == recommendedFramework",
          "group": "inline"
        },
        {
          "command": "qagenai.installFramework",
          "when": "view == qagenai.coverageView && viewItem == recommendedFramework"
        },
        {
          "command": "qagenai.generateAllTests",
          "when": "view == qagenai.coverageView && viewItem == category",
          "group": "inline"
        },
        {
          "command": "qagenai.runTests",
          "when": "view == qagenai.coverageView && viewItem =~ /testType-.*-installed/",
          "group": "inline"
        },
        {
          "command": "qagenai.installTestFramework",
          "when": "view == qagenai.coverageView && viewItem =~ /testType-.*-missing/",
          "group": "inline"
        },
        {
          "command": "qagenai.installTestFramework",
          "when": "view == qagenai.coverageView && viewItem =~ /testType-.*-notConfigured/",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "qagenai.analyzeWorkspace",
          "when": "view == qagenai.coverageView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qagenai",
          "title": "QAgenAI",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "qagenai": [
        {
          "type": "webview",
          "id": "qagenai.coverageView",
          "name": "Test Coverage",
          "icon": "$(graph)",
          "contextualTitle": "Coverage Analysis"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "qagenai.coverageView",
        "contents": "Welcome to QAgenAI! ✨\n\nAnalyze your project to see test coverage.\n\n[$(sync) Analyze Project](command:qagenai.analyzeWorkspace)\n\n[$(sparkle) Generate Tests](command:qagenai.generateTests)\n\nOr right-click any file to generate tests."
      }
    ],
    "configuration": {
      "title": "QAgenAI",
      "properties": {
        "qagenai.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "**Claude API Key** for AI test generation\n\nGet your API key from: [Anthropic Console](https://console.anthropic.com)"
        },
        "qagenai.apiUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "markdownDescription": "**Backend API URL**\n\nDefault: `http://localhost:3001`"
        },
        "qagenai.enableAnimations": {
          "type": "boolean",
          "default": true,
          "description": "Enable smooth animations and transitions in the UI"
        },
        "qagenai.autoAnalyze": {
          "type": "boolean",
          "default": true,
          "description": "Automatically analyze coverage when workspace opens"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "playwright": "^1.57.0"
  }
}
