+        cfg = cfg.replace(
+          /use:\s*\{([^}]*)\}/,
+          (match, content) => {
+            const trimmed = content.trim();
+            // If content ends with comma, just add storageState
+            // Otherwise add comma before storageState
+            const needsComma = trimmed && !trimmed.endsWith(',');
+            return `use: {${content}${needsComma ? ',' : ''}
+    storageState: 'playwright/.auth/user.json',
+  }`;
+          }
+        );
+      }
+      await fs.writeFile(pwConfig, cfg, 'utf-8');
+    } catch {}
+
+    return { success: true, setupFile: path.relative(projectPath, setupFile) };
+  }
+
+  @Post('generate-from-case')
+  async generateFromCase(
+    @Body() body: {
+      testCase: {
+        id: string;
+        name: string;
+        description?: string;
+        priority?: string;
+        steps: Array<{
+          action: string;
+          target: string;
+          value?: string;
+          selector?: string;
+          expectedResult?: string;
+          description?: string;
+          assertions?: string[];
+          api?: { method: string; endpoint: string; expectedStatus?: number };
+        }>;
+        testData?: Record<string, any>;
+        metadata?: {
+          components?: string[];
+          apis?: string[];
+          selectors?: string[];
+        };
+      };
+      suite: {
+        id: string;
+        name: string;
+        category?: string;
+      };
+      workspacePath: string;
+      baseUrl?: string;
+    }
+  ): Promise<any> {
+    const { testCase, suite, workspacePath, baseUrl } = body;
+    console.log(`🧪 API: Generate From Case: ${testCase.name}`);
+    console.log(`   Suite: ${suite.name}, Steps: ${testCase.steps?.length || 0}`);
+    
+    try {
+      this.gateway.emitTestGenerationProgress(workspacePath, {
+        step: 'Analyzing test case',
+        percentage: 10,
+        message: 'Starting test generation...'
+      });
+
+      const testCode = this.generateTestFromSteps(testCase, suite, baseUrl);
+      const fileName = this.getTestFileName(testCase.name);
+      
+      const stats = {
+        lines: testCode.split('\n').length,
+        testCases: (testCode.match(/test\(/g) || []).length,
+        assertions: (testCode.match(/expect\(/g) || []).length
+      };
+
+      this.gateway.emitTestGenerationComplete(workspacePath, {
+        code: testCode,
+        filePath: `tests/e2e/${fileName}`,
+        stats,
+        testCases: [{ name: testCase.name, type: 'e2e' }]
+      });
+      
+      console.log(`  ✅ Generated: ${fileName} (${stats.lines} lines, ${stats.assertions} assertions)`);
+      
+      return {
+        success: true,
+        testCode,
+        fileName,
+        filePath: `tests/e2e/${fileName}`,
+        stats: {
+          linesOfCode: stats.lines,
+          testCases: stats.testCases,
+          assertions: stats.assertions
+        }
+      };
+    } catch (error) {
+      console.error('  ❌ Generation failed:', error);
+      this.gateway.emitTestGenerationError(workspacePath, error.message);
+      return { success: false, error: error.message };
+    }
+  }
+
+  /**
+   * Generate professional Playwright test from Steps
+   */
+  private generateTestFromSteps(
+    testCase: any,
+    suite: any,
+    baseUrl?: string
+  ): string {
+    const lines: string[] = [];
+    const steps = testCase.steps || [];
+    
+    // Professional header with metadata
+    lines.push(`/**`);
+    lines.push(` * @suite ${suite.name}`);
+    lines.push(` * @case ${testCase.name}`);
+    lines.push(` * @description ${testCase.description || 'Auto-generated test'}`);
+    lines.push(` * @priority ${testCase.priority || 'MEDIUM'}`);
+    lines.push(` * @generated ${new Date().toISOString()}`);
+    lines.push(` */`);
+    lines.push(`import { test, expect, Page } from '@playwright/test';`);
+    lines.push('');
+    
+    // Test data constants
+    const testData = this.extractTestData(steps);
+    if (Object.keys(testData).length > 0) {
+      lines.push(`// Test Data`);
+      lines.push(`const TEST_DATA = ${JSON.stringify(testData, null, 2)};`);
+      lines.push('');
+    }
+    
+    // Helper functions
+    lines.push(`// Self-healing selector helper`);
+    lines.push(`async function smartLocator(page: Page, target: string, selector?: string) {`);
+    lines.push(`  const strategies = [`);
+    lines.push(`    selector ? () => page.locator(selector) : null,`);
+    lines.push(`    () => page.getByTestId(target),`);
+    lines.push(`    () => page.getByRole('textbox', { name: new RegExp(target, 'i') }),`);
+    lines.push(`    () => page.getByRole('button', { name: new RegExp(target, 'i') }),`);
+    lines.push(`    () => page.getByLabel(new RegExp(target, 'i')),`);
+    lines.push(`    () => page.getByPlaceholder(new RegExp(target, 'i')),`);
+    lines.push(`    () => page.locator(\`[name="\${target}"]\`),`);
+    lines.push(`    () => page.locator(\`#\${target}\`),`);
+    lines.push(`    () => page.locator(\`[data-testid*="\${target}" i]\`),`);
+    lines.push(`  ].filter(Boolean);`);
+    lines.push(``);
+    lines.push(`  for (const strategy of strategies) {`);
+    lines.push(`    try {`);
+    lines.push(`      const loc = strategy!();`);
+    lines.push(`      if (await loc.count() > 0) return loc.first();`);
+    lines.push(`    } catch {}`);
+    lines.push(`  }`);
+    lines.push(`  throw new Error(\`Element not found: \${target}\`);`);
+    lines.push(`}`);
+    lines.push('');
+    
+    // Main test describe block
+    lines.push(`test.describe('${suite.name} - ${testCase.name}', () => {`);
+    
+    // BeforeEach for common setup
+    const navigateStep = steps.find((s: any) => s.action === 'navigate');
+    if (navigateStep) {
+      lines.push(`  test.beforeEach(async ({ page }) => {`);
+      const url = navigateStep.target.startsWith('/') ? navigateStep.target : `/${navigateStep.target}`;
+      lines.push(`    await page.goto('${url}');`);
+      lines.push(`    await page.waitForLoadState('networkidle');`);
+      lines.push(`  });`);
+      lines.push('');
+    }
+    
+    // Main happy path test
+    lines.push(`  test('should complete ${testCase.name.toLowerCase()} successfully', async ({ page }) => {`);
+    
+    let stepIndex = 0;
+    for (const step of steps) {
+      stepIndex++;
+      const comment = step.description || `Step ${stepIndex}: ${step.action} ${step.target}`;
+      lines.push(`    // ${comment}`);
+      
+      switch (step.action) {
+        case 'navigate':
+          // Skip if already in beforeEach
+          if (!navigateStep) {
+            const url = step.target.startsWith('/') ? step.target : `/${step.target}`;
+            lines.push(`    await page.goto('${url}');`);
+          }
+          break;
+          
+        case 'fill':
+          const fillValue = step.value || testData[step.target] || 'test-value';
+          if (step.selector) {
+            lines.push(`    await page.locator('${step.selector}').fill('${fillValue}');`);
+          } else {
+            lines.push(`    const ${this.toCamelCase(step.target)}Field = await smartLocator(page, '${step.target}');`);
+            lines.push(`    await ${this.toCamelCase(step.target)}Field.fill('${fillValue}');`);
+          }
+          break;
+          
+        case 'click':
+          if (step.selector) {
+            lines.push(`    await page.locator('${step.selector}').click();`);
+          } else {
+            lines.push(`    const ${this.toCamelCase(step.target)}Btn = await smartLocator(page, '${step.target}');`);
+            lines.push(`    await ${this.toCamelCase(step.target)}Btn.click();`);
+          }
+          break;
+          
+        case 'submit':
+          if (step.selector) {
+            lines.push(`    await page.locator('${step.selector}').click();`);
+          } else {
+            lines.push(`    await page.locator('button[type="submit"]').click();`);
+          }
+          lines.push(`    await page.waitForLoadState('networkidle');`);
+          break;
+          
+        case 'verify':
+          this.addVerification(lines, step);
+          break;
+          
+        case 'wait':
+          const waitTime = parseInt(step.value || '1000');
+          lines.push(`    await page.waitForTimeout(${waitTime});`);
+          break;
+          
+        case 'api-call':
+          if (step.api) {
+            lines.push(`    const response = await page.waitForResponse(`);
+            lines.push(`      resp => resp.url().includes('${step.api.endpoint}') && resp.request().method() === '${step.api.method}'`);
+            lines.push(`    );`);
+            if (step.api.expectedStatus) {
+              lines.push(`    expect(response.status()).toBe(${step.api.expectedStatus});`);
+            }
+          }
+          break;
+      }
+      
+      // Add assertions from step
+      if (step.assertions?.length) {
+        for (const assertion of step.assertions) {
+          lines.push(`    // Assertion: ${assertion}`);
+          lines.push(`    await expect(page.locator('text=${assertion}')).toBeVisible();`);
+        }
+      }
+      
+      // Add expected result as assertion
+      if (step.expectedResult && step.action !== 'verify') {
+        lines.push(`    // Expected: ${step.expectedResult}`);
+      }
+      
+      lines.push('');
+    }
+    
+    // Final assertions - only add if last step wasn't a verify action
+    const lastStep = steps[steps.length - 1];
+    if (lastStep?.expectedResult && lastStep.action !== 'verify') {
+      lines.push(`    // Final state verification`);
+      if (lastStep.expectedResult.includes('/')) {
+        const escapedUrl = lastStep.expectedResult.replace(/\//g, '\\/'); 
+        lines.push(`    await expect(page).toHaveURL(/.*${escapedUrl}/);`);
+      } else {
+        lines.push(`    await expect(page.locator('text=${lastStep.expectedResult}')).toBeVisible();`);
+      }
+    }
+    
+    lines.push(`  });`);
+    
+    // Add negative tests
+    this.addNegativeTests(lines, testCase, steps);
+    
+    lines.push(`});`);
+    
+    return lines.join('\n');
+  }
+  
+  /**
+   * Extract test data from steps
+   */
+  private extractTestData(steps: any[]): Record<string, string> {
+    const data: Record<string, string> = {};
+    for (const step of steps) {
+      if (step.action === 'fill' && step.value) {
+        data[step.target] = step.value;
+      }
+    }
+    return data;
+  }
+  
+  /**
+   * Add verification step code
+   */
+  private addVerification(lines: string[], step: any): void {
+    const target = step.target.toLowerCase();
+    
+    if (target.includes('url') || step.expectedResult?.includes('/')) {
+      const url = step.expectedResult || step.value || step.target;
+      // Use regex pattern with .* to match any prefix (baseUrl)
+      const escapedUrl = url.replace(/\//g, '\\/'); // Escape forward slashes for regex
+      lines.push(`    await expect(page).toHaveURL(/.*${escapedUrl}/)`);
+    } else if (target.includes('text') || target.includes('message')) {
+      const text = step.expectedResult || step.value || step.target;
+      lines.push(`    await expect(page.locator('text=${text}')).toBeVisible();`);
+    } else if (target.includes('visible')) {
+      const selector = step.selector || `[data-testid="${step.target}"]`;
+      lines.push(`    await expect(page.locator('${selector}')).toBeVisible();`);
+    } else if (target.includes('hidden') || target.includes('invisible')) {
+      const selector = step.selector || `[data-testid="${step.target}"]`;
+      lines.push(`    await expect(page.locator('${selector}')).toBeHidden();`);
+    } else if (target.includes('enabled')) {
+      const selector = step.selector || `[data-testid="${step.target}"]`;
+      lines.push(`    await expect(page.locator('${selector}')).toBeEnabled();`);
+    } else if (target.includes('disabled')) {
+      const selector = step.selector || `[data-testid="${step.target}"]`;
+      lines.push(`    await expect(page.locator('${selector}')).toBeDisabled();`);
+    } else {
+      // Generic assertion
+      const text = step.expectedResult || step.value || step.target;
+      lines.push(`    await expect(page.getByText('${text}')).toBeVisible();`);
+    }
+  }
+  
+  /**
+   * Add negative/edge case tests
+   */
+  private addNegativeTests(lines: string[], testCase: any, steps: any[]): void {
+    const fillSteps = steps.filter((s: any) => s.action === 'fill');
+    
+    if (fillSteps.length === 0) return;
+    
+    lines.push('');
+    lines.push(`  // Negative Tests`);
+    
+    // Empty field test
+    lines.push(`  test('should show validation errors for empty fields', async ({ page }) => {`);
+    lines.push(`    // Submit without filling required fields`);
+    lines.push(`    await page.locator('button[type="submit"]').click();`);
+    lines.push(`    `);
+    lines.push(`    // Expect validation error`);
+    lines.push(`    await expect(page.locator('[class*="error"], [role="alert"], .error-message').first()).toBeVisible();`);
+    lines.push(`  });`);
+    
+    // Invalid email test (if email field exists)
+    const emailStep = fillSteps.find((s: any) => 
+      s.target.toLowerCase().includes('email') || 
+      s.selector?.includes('email')
+    );
+    
+    if (emailStep) {
+      lines.push('');
+      lines.push(`  test('should show error for invalid email format', async ({ page }) => {`);
+      if (emailStep.selector) {
+        lines.push(`    await page.locator('${emailStep.selector}').fill('invalid-email');`);
+      } else {
+        lines.push(`    const emailField = await smartLocator(page, '${emailStep.target}');`);
+        lines.push(`    await emailField.fill('invalid-email');`);
+      }
+      lines.push(`    await page.locator('button[type="submit"]').click();`);
+      lines.push(`    `);
+      lines.push(`    await expect(page.locator('text=/invalid|email|format/i')).toBeVisible();`);
+      lines.push(`  });`);
+    }
+    
+    // Password mismatch test (if confirm password exists)
+    const passwordStep = fillSteps.find((s: any) => 
+      s.target.toLowerCase().includes('password') && 
+      !s.target.toLowerCase().includes('confirm')
+    );
+    const confirmStep = fillSteps.find((s: any) => 
+      s.target.toLowerCase().includes('confirm')
+    );
+    
+    if (passwordStep && confirmStep) {
+      lines.push('');
+      lines.push(`  test('should show error for password mismatch', async ({ page }) => {`);
+      lines.push(`    // Fill all fields but with mismatched passwords`);
+      for (const step of fillSteps) {
+        const value = step.target.toLowerCase().includes('confirm') 
+          ? 'DifferentPassword123!' 
+          : (step.value || 'TestPassword123!');
+        if (step.selector) {
+          lines.push(`    await page.locator('${step.selector}').fill('${value}');`);
+        } else {
+          lines.push(`    await (await smartLocator(page, '${step.target}')).fill('${value}');`);
+        }
+      }
+      lines.push(`    await page.locator('button[type="submit"]').click();`);
+      lines.push(`    `);
+      lines.push(`    await expect(page.locator('text=/match|mismatch|same/i')).toBeVisible();`);
+      lines.push(`  });`);
+    }
+  }
+  
+  /**
+   * Convert string to camelCase
+   */
+  private toCamelCase(str: string): string {
+    return str
+      .toLowerCase()
+      .replace(/[^a-zA-Z0-9]+(.)/g, (_, chr) => chr.toUpperCase())
+      .replace(/^[A-Z]/, c => c.toLowerCase());
+  }
+
+  /**
+   * Extract test cases from generated code
+   */
+  private extractTestCases(code: string): Array<{ name: string; type: string }> {
+    const testCaseMatches = code.match(/test\(['"](.*)['"]/g) || [];
+    return testCaseMatches.map(m => {
+      const match = m.match(/['"](.*?)['"]/);
+      return {
+        name: match?.[1] || '',
+        type: 'test'
+      };
+    });
+  }
   
