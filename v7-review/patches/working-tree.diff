+      const recentRuns = runs.slice(-5);
+      const hasPassed = recentRuns.some(r => r.status === 'passed');
+      const hasFailed = recentRuns.some(r => r.status === 'failed');
+      
+      if (hasPassed && hasFailed) {
+        flakyCount++;
+      }
+    });
+    
+    return flakyCount;
+  }
